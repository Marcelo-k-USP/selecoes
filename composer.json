{
    "name": "uspdev/selecoes",
    "type": "project",
    "description": "Seleções",
    "authors": [
        {
            "name": "Marcelo k",
            "email": "makf00@usp.br",
            "homepage": "https://github.com/Marcelo-k-USP"
        }
    ],
    "keywords": [
        "uspdev",
        "selecoes"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "glorand/laravel-model-settings": "*",
        "guzzlehttp/guzzle": "^7.15.2",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "*",
        "laravel/tinker": "*",
        "laravel/ui": "*",
        "league/commonmark": "^2.9.0",
        "spatie/commonmark-highlighter": "^3.0",
        "spatie/laravel-html": "*",
        "spatie/simple-excel": "*",
        "uspdev/boleto": "^1.0",
        "uspdev/laravel-replicado": "^1.0",
        "uspdev/laravel-tools": "^1.7",
        "uspdev/laravel-usp-theme": "^2.7",
        "uspdev/senhaunica-socialite": "^4.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/dusk": "*",
        "laravel/sail": "*",
        "lucascudo/laravel-pt-br-localization": "^1.2",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "*",
        "phpunit/phpunit": "^11.5.50",
        "spatie/laravel-ignition": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --provider=\"Uspdev\\UspTheme\\ServiceProvider\" --tag=assets --force"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "[ $COMPOSER_DEV_MODE -eq 0 ] || php artisan vendor:publish --tag=laravel-pt-br-localization --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
